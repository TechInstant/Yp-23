# Copy to .env and fill from Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (optional, free on the Spark plan).
# Firebase Console -> App Check -> Apps -> register the web app with
# reCAPTCHA v3, and paste the SITE key here. Leave blank and App Check
# simply stays off.
#
# Order matters: set the key, deploy, confirm the console shows verified
# requests, and only then switch on enforcement. Enforcing first locks
# every visitor out.
VITE_RECAPTCHA_SITE_KEY=

# Server-side scripts only (scripts/seed.mjs, scripts/make-admin.mjs).
# Path to the service-account JSON downloaded from
# Project settings -> Service accounts -> Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
