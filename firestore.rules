rules_version = '2';

// RCCG Youth Province 23 — attendance portal.
//
// Threat model: the parish registration form and the attendance form are open to
// the public (pastors submit from their phones, no account). So the rules — not
// the UI — are what stop bad data and protect pastors' phone numbers.
//
//   parishes/{id}        public read (needed by the dropdowns), public create
//                        (self-registration, forced to status "pending"), public
//                        update of pastorName only, admin-only delete.
//                        NO phone number here.
//   parishContacts/{id}  phone number + the filing pastor's name. Public write
//                        in a narrow shape, refreshed by every return.
//                        Admin-only read.
//   attendance/{id}      public read, public create, admin-only update/delete.
//                        The doc id is "{parishId}_{YYYY-MM-DD}", so a second
//                        submission for the same Sunday collides with the first
//                        instead of silently duplicating the parish in the
//                        charts.
//   admins/{uid}         the allow-list. Written from the Firebase console or
//                        scripts/make-admin.mjs only — never from a client.
//                        Creating the first admin in the console works because
//                        console writes are authorised by IAM and bypass rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * Super admins are the only ones who can grant or revoke admin access.
     *
     * An admin document with no `role` field defaults to super: the only way to
     * get one before this feature existed was by hand in the Firebase console,
     * which means the project owner created it. Defaulting those to plain admin
     * would lock the province out of its own admin list.
     */
    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid))
             .data.get('role', 'super') == 'super';
    }

    /** The signed-in user's email, lowercased — the id an invite is filed under. */
    function myEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function invitePath(email) {
      return /databases/$(database)/documents/adminInvites/$(email);
    }

    function incoming() {
      return request.resource.data;
    }

    // The tracking window: first Sunday of September 2026 through the last
    // Sunday of December 2029. Kept in sync with src/lib/sundays.ts.
    function isTrackedSunday(d) {
      return d is string
        // Rules cannot compute a weekday, so a determined writer could still
        // post a Tuesday inside the window. The charts only bucket real tracked
        // Sundays, so such a row would be invisible there while still counting
        // in the totals — analytics therefore filters to tracked Sundays too,
        // keeping the two consistent. This regex at least rejects impossible
        // dates like 2026-19-05 and 2026-09-39.
        && d.matches('^20(2[6-9])-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d >= '2026-09-06'
        && d <= '2029-12-30';
    }

    match /admins/{uid} {
      // Anyone signed in may read their OWN record, admins may read the list.
      //
      // Without the self clause this is circular: isAdmin() is "your admin
      // document exists", so someone who does not yet have one is refused
      // permission to discover that fact. Every sign-in by a non-admin then
      // threw permission-denied, and because that throw happened before the
      // invitation lookup, an invitee could never redeem their invitation.
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);

      /**
       * Self-claim against an invitation.
       *
       * A browser cannot look a user up by email — that needs the Admin SDK,
       * and this project has no service-account key (the organisation policy
       * blocks creating one). So access is granted the other way round: a super
       * admin files an invitation under the invitee's email, the invitee signs
       * up themselves, and this rule lets them convert that invitation into an
       * admin record for their own uid and no one else's.
       *
       * The role is read from the invitation rather than trusted from the
       * client, so an invitee cannot promote themselves to super.
       */
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && myEmail() != ''
                    && exists(invitePath(myEmail()))
                    && incoming().keys().hasOnly(['email', 'role', 'grantedAt', 'grantedBy'])
                    && incoming().email == myEmail()
                    && incoming().role == get(invitePath(myEmail())).data.role
                    && incoming().grantedAt == request.time;

      // Changing or removing someone else's access is a super-admin action.
      // Touching your own record is refused outright, so a super admin cannot
      // demote or delete themselves and strand the province with no one able
      // to manage the list.
      allow update, delete: if isSuperAdmin() && uid != request.auth.uid;
    }

    match /adminInvites/{inviteId} {
      // An invitee may read and clear their own invitation; admins see them all.
      allow read: if isAdmin() || (myEmail() != '' && inviteId == myEmail());

      allow create, update: if isSuperAdmin()
                            && inviteId == incoming().email
                            && incoming().keys().hasOnly(['email', 'role', 'invitedBy', 'createdAt'])
                            && incoming().email is string
                            && incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                            && incoming().email == incoming().email.lower()
                            && incoming().role in ['super', 'admin'];

      allow delete: if isSuperAdmin() || (myEmail() != '' && inviteId == myEmail());
    }

    match /parishes/{parishId} {
      allow read: if true;

      // Admins add parishes from the admin panel (status "active", source
      // "admin"); everyone else goes through the public registration form,
      // which may only ever produce a pending self-registration.
      allow create: if isAdmin() ||
                    (
                      incoming().keys().hasOnly([
                        'name', 'pastorName', 'status', 'source',
                        'createdAt', 'updatedAt'
                      ])
                      && incoming().name is string
                      && incoming().name.size() >= 2
                      && incoming().name.size() <= 120
                      && incoming().pastorName is string
                      && incoming().pastorName.size() >= 2
                      && incoming().pastorName.size() <= 120
                      && incoming().status == 'pending'
                      && incoming().source == 'self-registration'
                      && incoming().createdAt == request.time
                    );

      // Claiming a parish: the pastor in charge writes their own name against a
      // parish already in the directory. Only the name — the phone number goes
      // to parishContacts. Re-claiming is allowed so a parish that changes
      // hands is not stuck with the previous pastor's name until an admin
      // intervenes; the province sees every change through the contact card's
      // updatedAt.
      allow update: if isAdmin() ||
                    (
                      incoming().diff(resource.data).affectedKeys().hasOnly([
                        'pastorName', 'updatedAt'
                      ])
                      && incoming().pastorName is string
                      && incoming().pastorName.size() >= 2
                      && incoming().pastorName.size() <= 120
                    );

      allow delete: if isAdmin();
    }

    match /parishContacts/{parishId} {
      // Phone numbers are PII: never readable by the public, even though the
      // parish record itself is.
      allow read: if isAdmin();

      // Every attendance submission carries the filing pastor's name and phone,
      // and refreshes this card — otherwise the province's contact list would
      // still hold whoever was in charge in 2026. So writes are open to the
      // public, in the same narrow shape as the submission form, and are
      // limited to contact fields: nothing here reaches the parish record, the
      // attendance figures, or the admin list.
      //
      // Anyone who can submit attendance can therefore also change a contact
      // number. That is the same trust level the attendance form already grants,
      // and an admin can correct it — whereas locking it to write-once would
      // freeze the directory the first time a pastor filed a return.
      function validContact() {
        return incoming().keys().hasOnly([
                 'phone', 'pastorName', 'lastSeenOn', 'createdAt', 'updatedAt'
               ])
               && incoming().phone is string
               && incoming().phone.size() >= 7
               && incoming().phone.size() <= 25
               && incoming().pastorName is string
               && incoming().pastorName.size() >= 2
               && incoming().pastorName.size() <= 120;
      }

      allow create: if isAdmin() || validContact();
      allow update: if isAdmin() || validContact();
      allow delete: if isAdmin();
    }

    match /attendance/{recordId} {
      // Aggregate attendance figures are not sensitive, and parishes should be
      // able to see the province-wide chart.
      allow read: if true;

      // Admins record returns phoned in by a parish, so they are exempt from
      // the create-only guard below (source "admin" rather than "parish-form").
      allow create: if isAdmin() ||
                    (
                      recordId == incoming().parishId + '_' + incoming().date
                      && incoming().keys().hasOnly([
                           'parishId', 'parishName', 'pastorName', 'date',
                           'attendance', 'note', 'source', 'createdAt', 'updatedAt'
                         ])
                      && exists(/databases/$(database)/documents/parishes/$(incoming().parishId))
                      && isTrackedSunday(incoming().date)
                      && incoming().pastorName is string
                      && incoming().pastorName.size() >= 2
                      && incoming().pastorName.size() <= 120
                      // parishName is denormalised onto the row and rendered in
                      // the admin tables and CSV exports, so it needs the same
                      // bounds as every other public-writable string.
                      && incoming().parishName is string
                      && incoming().parishName.size() >= 2
                      && incoming().parishName.size() <= 120
                      && incoming().attendance is int
                      && incoming().attendance >= 0
                      && incoming().attendance <= 100000
                      && incoming().note is string
                      && incoming().note.size() <= 300
                      && incoming().source == 'parish-form'
                      && incoming().createdAt == request.time
                    );

      allow update, delete: if isAdmin();
    }
  }
}
