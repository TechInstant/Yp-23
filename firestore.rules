rules_version = '2';

// RCCG Youth Province 23 — attendance portal.
//
// Threat model: the parish registration form and the attendance form are open to
// the public (pastors submit from their phones, no account). So the rules — not
// the UI — are what stop bad data and protect pastors' phone numbers.
//
//   parishes/{id}        public read (needed by the dropdowns), public create
//                        (self-registration, forced to status "pending"), public
//                        update of pastorName only, admin-only delete.
//                        NO phone number here.
//   parishContacts/{id}  phone number + the filing pastor's name. Public write
//                        in a narrow shape, refreshed by every return.
//                        Admin-only read.
//   attendance/{id}      public read, public create, admin-only update/delete.
//                        The doc id is "{parishId}_{YYYY-MM-DD}", so a second
//                        submission for the same Sunday collides with the first
//                        instead of silently duplicating the parish in the
//                        charts.
//   admins/{uid}         the allow-list. Written from the Firebase console or
//                        scripts/make-admin.mjs only — never from a client.
//                        Creating the first admin in the console works because
//                        console writes are authorised by IAM and bypass rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    // The tracking window: first Sunday of September 2026 through the last
    // Sunday of December 2029. Kept in sync with src/lib/sundays.ts.
    function isTrackedSunday(d) {
      return d is string
        && d.matches('^20(2[6-9])-[0-1][0-9]-[0-3][0-9]$')
        && d >= '2026-09-06'
        && d <= '2029-12-30';
    }

    match /admins/{uid} {
      // An admin may read the allow-list; nobody may edit it from a browser.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /parishes/{parishId} {
      allow read: if true;

      // Admins add parishes from the admin panel (status "active", source
      // "admin"); everyone else goes through the public registration form,
      // which may only ever produce a pending self-registration.
      allow create: if isAdmin() ||
                    (
                      incoming().keys().hasOnly([
                        'name', 'pastorName', 'status', 'source',
                        'createdAt', 'updatedAt'
                      ])
                      && incoming().name is string
                      && incoming().name.size() >= 2
                      && incoming().name.size() <= 120
                      && incoming().pastorName is string
                      && incoming().pastorName.size() >= 2
                      && incoming().pastorName.size() <= 120
                      && incoming().status == 'pending'
                      && incoming().source == 'self-registration'
                      && incoming().createdAt == request.time
                    );

      // Claiming a parish: the pastor in charge writes their own name against a
      // parish already in the directory. Only the name — the phone number goes
      // to parishContacts. Re-claiming is allowed so a parish that changes
      // hands is not stuck with the previous pastor's name until an admin
      // intervenes; the province sees every change through the contact card's
      // updatedAt.
      allow update: if isAdmin() ||
                    (
                      incoming().diff(resource.data).affectedKeys().hasOnly([
                        'pastorName', 'updatedAt'
                      ])
                      && incoming().pastorName is string
                      && incoming().pastorName.size() >= 2
                      && incoming().pastorName.size() <= 120
                    );

      allow delete: if isAdmin();
    }

    match /parishContacts/{parishId} {
      // Phone numbers are PII: never readable by the public, even though the
      // parish record itself is.
      allow read: if isAdmin();

      // Every attendance submission carries the filing pastor's name and phone,
      // and refreshes this card — otherwise the province's contact list would
      // still hold whoever was in charge in 2026. So writes are open to the
      // public, in the same narrow shape as the submission form, and are
      // limited to contact fields: nothing here reaches the parish record, the
      // attendance figures, or the admin list.
      //
      // Anyone who can submit attendance can therefore also change a contact
      // number. That is the same trust level the attendance form already grants,
      // and an admin can correct it — whereas locking it to write-once would
      // freeze the directory the first time a pastor filed a return.
      function validContact() {
        return incoming().keys().hasOnly([
                 'phone', 'pastorName', 'lastSeenOn', 'createdAt', 'updatedAt'
               ])
               && incoming().phone is string
               && incoming().phone.size() >= 7
               && incoming().phone.size() <= 25
               && incoming().pastorName is string
               && incoming().pastorName.size() >= 2
               && incoming().pastorName.size() <= 120;
      }

      allow create: if isAdmin() || validContact();
      allow update: if isAdmin() || validContact();
      allow delete: if isAdmin();
    }

    match /attendance/{recordId} {
      // Aggregate attendance figures are not sensitive, and parishes should be
      // able to see the province-wide chart.
      allow read: if true;

      // Admins record returns phoned in by a parish, so they are exempt from
      // the create-only guard below (source "admin" rather than "parish-form").
      allow create: if isAdmin() ||
                    (
                      recordId == incoming().parishId + '_' + incoming().date
                      && incoming().keys().hasOnly([
                           'parishId', 'parishName', 'pastorName', 'date',
                           'attendance', 'note', 'source', 'createdAt', 'updatedAt'
                         ])
                      && exists(/databases/$(database)/documents/parishes/$(incoming().parishId))
                      && isTrackedSunday(incoming().date)
                      && incoming().pastorName is string
                      && incoming().pastorName.size() >= 2
                      && incoming().pastorName.size() <= 120
                      && incoming().attendance is int
                      && incoming().attendance >= 0
                      && incoming().attendance <= 100000
                      && incoming().note is string
                      && incoming().note.size() <= 300
                      && incoming().source == 'parish-form'
                      && incoming().createdAt == request.time
                    );

      allow update, delete: if isAdmin();
    }
  }
}
